# Local Ollama LLM container used by the OCR pipeline (demo highlight, qwen2.5:1.5b).
# The model (~1 GB) is pulled from the registry on first container start, so the
# first inference is slow — keep this app at minReplicas 1 and warm it up early.
FROM ollama/ollama

COPY scripts/ollama-entrypoint.sh /ollama-entrypoint.sh
RUN chmod +x /ollama-entrypoint.sh

# ACA HTTP ingress forwards to the container target port; Ollama must bind all
# interfaces, not the default loopback.
ENV OLLAMA_HOST=0.0.0.0

EXPOSE 11434

ENTRYPOINT ["/bin/bash", "/ollama-entrypoint.sh"]